configuration {
    modes: "window,drun,filebrowser";
    terminal: "alacritty";
    run-shell-command: "{terminal} -e {cmd}";
    // if only one item is left in the list, automatically select it
    auto-select: true;
    font: "FantasqueSansM Nerd Font 13";
    show-icons: true;
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method: "name";
        show-hidden: true;
    }
    window-thumbnail: true;
}

// run rofi-theme-selector from the terminal to change theme
@theme "./themes/sidebar3.rasi"
