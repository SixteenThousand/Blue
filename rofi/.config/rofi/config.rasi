configuration {
    modes: "window,drun,filebrowser";
    run-shell-command: "{terminal} -e {cmd}";
    // if only one item is left in the list, automatically select it
    auto-select: true;
    font: "mono 12";
    show-icons: true;
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method: "name";
        show-hidden: true;
    }
    drun-match-fields: "name,generic";
    window-thumbnail: true;
    case-smart: true;
}

@theme "./themes/mysidebar.rasi"
