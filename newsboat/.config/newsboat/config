# vim: set cms=# %s
show-read-articles yes
wrap-scroll yes
text-width 120
browser "firefox --new-tab"

bind-key j next
bind-key k prev
bind-key J next-feed
bind-key K prev-feed
bind-key , view-dialogs
bind-key ; macro-prefix
bind-key e toggle-article-read
macro a \
    enqueue; \
    toggle-article-read; \
    -- "setup a download"

# podboat stuff
download-path ~/Downloads
max-downloads 3
download-filename-format %n-%t.%e

save-path ~/Downloads


include /usr/share/doc/newsboat/contrib/colorschemes/plain
