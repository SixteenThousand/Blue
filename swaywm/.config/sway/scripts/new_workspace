#!/usr/bin/env python3

import json
import subprocess
import os
import sys
from datetime import datetime

def core(args):
    proc = subprocess.run(
        ["swaymsg", "-r", "-t", "get_workspaces"],
        capture_output=True
    )
    workspaces = json.loads(proc.stdout)
    new_ws_num = -1
    for ws in workspaces:
        if ws["focused"]:
            # Check if the workspace was empty before this window
            if ws["representation"].find(" ") == -1:
                return
            if ws["floating"] != None:
                return
        if ws["num"] > new_ws_num:
            new_ws_num = ws["num"]
    new_ws_num += 1
    cmd = f"workspace {new_ws_num}"
    if len(args) > 1 and args[1] == "with_window":
        cmd = f"move window to workspace {new_ws_num}; " + cmd
    subprocess.run(["swaymsg", cmd])

def log_err(err):
    log = open(os.environ["HOME"] + "/Swayext.log", "a")
    log.write(str(datetime.now()) + " | " + repr(err) + "\n")
    log.close()
    subprocess.run(["notify-send", "sway", "error!"])

try:
    core(sys.argv)
except Exception as err:
    log_err(err)
